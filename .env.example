# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Hanya di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 32 byte acak dalam base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Melindungi endpoint worker: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# OrderOnline Open API (Partner API key hanya diberikan OrderOnline kepada partner)
ORDERONLINE_BASE_URL=https://open-api.orderonline.id/open-api
ORDERONLINE_PARTNER_API_KEY=

# URL publik aplikasi (dipakai untuk menampilkan URL webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000
