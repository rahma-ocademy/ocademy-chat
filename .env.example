# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Hanya di server. Jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 32 byte acak dalam base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Melindungi endpoint worker: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# OrderOnline Open API (Partner API key hanya diberikan OrderOnline kepada partner)
ORDERONLINE_BASE_URL=https://open-api.orderonline.id/open-api
ORDERONLINE_PARTNER_API_KEY=

# URL publik aplikasi (dipakai untuk menampilkan URL webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp (Meta App → WhatsApp). Kosong = tombol "Login dengan Facebook" menampilkan penjelasan.
META_APP_ID=
# Dipakai menukar kode Embedded Signup DAN memverifikasi tanda tangan webhook (X-Hub-Signature-256).
META_APP_SECRET=
# Facebook Login for Business → Configurations → konfigurasi WhatsApp Embedded Signup.
META_ES_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# Bebas, harus sama dengan "Verify token" di Meta App → WhatsApp → Configuration → Webhook.
WHATSAPP_VERIFY_TOKEN=
# Bahasa template WhatsApp untuk follow-up (kode bahasa template di Meta).
WHATSAPP_TEMPLATE_LANGUAGE=id
